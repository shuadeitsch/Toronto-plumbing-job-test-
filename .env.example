# Passcode to open the book (leave empty only for local testing)
APP_PASSCODE=
# Optional: separate secret for signing the login cookie
SESSION_SECRET=

# Supabase (Project Settings → API). Without these the app runs on demo data.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Claude API key for the Ask tab (console.anthropic.com)
ANTHROPIC_API_KEY=
# Optional model override
# CLAUDE_MODEL=claude-opus-5-5
